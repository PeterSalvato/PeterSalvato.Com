---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ '/' | absolute_url }}</loc>
    <priority>1.0</priority>
  </url>
  {% for page in site.pages %}{% unless page.url contains '/assets/' or page.url contains '/test-results/' or page.url == '/sitemap.xml' or page.url == '/robots.txt' %}{% if page.title %}
  <url>
    <loc>{{ page.url | absolute_url }}</loc>{% if page.last_modified %}
    <lastmod>{{ page.last_modified | date: "%Y-%m-%d" }}</lastmod>{% endif %}
  </url>
  {% endif %}{% endunless %}{% endfor %}
  {% for doc in site.practice %}{% if doc.published != false %}
  <url>
    <loc>{{ doc.url | absolute_url }}</loc>{% if doc.last_modified %}
    <lastmod>{{ doc.last_modified | date: "%Y-%m-%d" }}</lastmod>{% endif %}
  </url>
  {% endif %}{% endfor %}
  {% for doc in site.systems %}{% if doc.published != false %}
  <url>
    <loc>{{ doc.url | absolute_url }}</loc>{% if doc.last_modified %}
    <lastmod>{{ doc.last_modified | date: "%Y-%m-%d" }}</lastmod>{% endif %}
  </url>
  {% endif %}{% endfor %}
  {% for doc in site.evidence %}{% if doc.published != false %}
  <url>
    <loc>{{ doc.url | absolute_url }}</loc>{% if doc.last_modified %}
    <lastmod>{{ doc.last_modified | date: "%Y-%m-%d" }}</lastmod>{% endif %}
  </url>
  {% endif %}{% endfor %}
  {% for doc in site.essays %}{% if doc.published != false %}
  <url>
    <loc>{{ doc.url | absolute_url }}</loc>{% if doc.date %}
    <lastmod>{{ doc.date | date: "%Y-%m-%d" }}</lastmod>{% endif %}
  </url>
  {% endif %}{% endfor %}
  {% for doc in site.research %}{% if doc.published != false %}
  <url>
    <loc>{{ doc.url | absolute_url }}</loc>{% if doc.last_modified %}
    <lastmod>{{ doc.last_modified | date: "%Y-%m-%d" }}</lastmod>{% endif %}
  </url>
  {% endif %}{% endfor %}
  {% for doc in site.work %}{% if doc.published != false %}
  <url>
    <loc>{{ doc.url | absolute_url }}</loc>{% if doc.last_modified %}
    <lastmod>{{ doc.last_modified | date: "%Y-%m-%d" }}</lastmod>{% endif %}
  </url>
  {% endif %}{% endfor %}
  {% for doc in site.brandwalks %}{% if doc.published != false %}
  <url>
    <loc>{{ doc.url | absolute_url }}</loc>{% if doc.last_modified %}
    <lastmod>{{ doc.last_modified | date: "%Y-%m-%d" }}</lastmod>{% endif %}
  </url>
  {% endif %}{% endfor %}
  {% for doc in site.versograms %}{% if doc.published != false %}
  <url>
    <loc>{{ doc.url | absolute_url }}</loc>
  </url>
  {% endif %}{% endfor %}
  {% for doc in site.photogeography %}{% if doc.published != false %}
  <url>
    <loc>{{ doc.url | absolute_url }}</loc>
  </url>
  {% endif %}{% endfor %}
  {% assign ei_sorted = site.ei | sort: "sequence" %}
  {% for doc in ei_sorted %}{% if doc.published != false %}
  <url>
    <loc>{{ doc.url | absolute_url }}</loc>{% if doc.last_modified %}
    <lastmod>{{ doc.last_modified | date: "%Y-%m-%d" }}</lastmod>{% endif %}
  </url>
  {% endif %}{% endfor %}
</urlset>
